{
  "name": "koma-manga",
  "version": "1.1.6",
  "private": true,
  "description": "KOMA — Futuristic OLED Manga Sanctuary powered by bundled verified sources",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:ui": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:ui && npm run build:electron",
    "pack:exe": "npm run build && electron-builder --win dir",
    "pack:portable": "npm run build && electron-builder --win portable",
    "start": "electron ."
  },
  "build": {
    "appId": "com.koma.manga",
    "productName": "KOMA",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "engine/build/libs/noctis-engine.jar",
        "to": "noctis-engine.jar"
      },
      {
        "from": "engine/jre",
        "to": "jre"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "dir"
      ]
    },
    "portable": {
      "artifactName": "KOMA-Portable.exe"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.3",
    "adm-zip": "^0.5.16",
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.3",
    "@tailwindcss/vite": "^4.0.9",
    "@types/adm-zip": "^0.5.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.0",
    "electron-builder": "^26.18.0",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
